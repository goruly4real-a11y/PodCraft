# ============================================================================
# FLUTTERWAVE CONFIGURATION
# ============================================================================
# Get your API keys from https://dashboard.flutterwave.com
# Never commit your .env file to version control!

# Public key for client-side payments (starts with FLWPUBK-)
VITE_FLUTTERWAVE_PUBLIC_KEY=

# ============================================================================
# SERVER-SIDE SECRETS (for Cloudflare Workers)
# ============================================================================
# These are set in Cloudflare dashboard, NOT in .env file
# Listed here for reference only

# Secret key for Flutterwave API calls (starts with FLWSECK-)
# FLW_SECRET_KEY=

# Secret hash for webhook signature verification
# Generate this in Flutterwave Dashboard > Settings > Webhooks
# FLW_SECRET_HASH=

# ============================================================================
# SUPABASE CONFIGURATION
# ============================================================================
# VITE_SUPABASE_URL=your_supabase_url
# VITE_SUPABASE_ANON_KEY=your_supabase_anon_key

# Server-side Supabase secrets (set in Cloudflare dashboard)
# SUPABASE_URL=your_supabase_url
# SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# ============================================================================
# ADCOMBO AD NETWORK
# ============================================================================
# Get your publisher ID from https://adcombo.com
# VITE_ADCOMBO_PUBLISHER_ID=your_publisher_id

# ============================================================================
# OTHER CONFIGURATION
# ============================================================================
# VITE_APP_URL=https://your-domain.com